{
  "name": "hearing-aid-demonstration-app",
  "productName": "Hearing-Aid-Demonstration-App",
  "version": "1.5.1",
  "description": "NU-6 Whole Word and Phoneme Scoring Application",
  "main": "main.js",
  "homepage": "https://github.com/euphonic-euphemism/NU6-Phoneme-Scorer",
  "scripts": {
    "build:js": "babel src/app.jsx --out-file build/app.js",
    "prestart": "npm run build:js",
    "prepack": "npm run build:js",
    "predist": "npm run build:js",
    "start": "electron . --no-sandbox",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "jest --runInBand"
  },
  "author": "Mark Shaver <mark.shaver@posteo.net>",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.0"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "build": {
    "appId": "com.audiology.hearingaiddemo",
    "productName": "Hearing-Aid-Demonstration-App",
    "files": [
      "main.js",
      "nu6_scoring_app.html",
      "tailwind.min.css",
      "*.csv",
      "audio/**/*",
      "BKB-SIN/**/*",
      "build/**/*"
    ],
    "asarUnpack": [
      "*.csv",
      "tailwind.min.css",
      "audio/**/*",
      "BKB-SIN/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "maintainer": "Mark Shaver <mark.shaver@posteo.net>",
      "category": "Science",
      "executableName": "hearing-aid-demonstration-app",
      "synopsis": "Phoneme scoring utility for audiology tests",
      "description": "A scoring application for NU-6 word lists with phoneme-level analysis."
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.medical"
    },
    "win": {
      "target": "nsis"
    }
  }
}
